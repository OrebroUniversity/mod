# CMake config for the mod library. Provides the imported target mod::mod.
@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(Boost)
find_dependency(Eigen3)
find_dependency(ompl)
find_dependency(nlohmann_json)

include("${CMAKE_CURRENT_LIST_DIR}/modTargets.cmake")
check_required_components(mod)
